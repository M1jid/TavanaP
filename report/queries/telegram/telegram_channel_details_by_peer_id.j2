{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "DATE": {
              "gte": "{{start_date}}",
              "lte": "{{end_date}}"
            }
          }
        },
        {
          "terms": {
            "PEER_ID": [
              {% for peer_id in peer_ids %}
                {{ peer_id }}{% if not loop.last %},{% endif %}
              {% endfor %}
            ]
          }
        }
      ]
    }
  },
  "aggs": {
    "global_stats": {
      "filter": { "match_all": {} },
      "aggs": {
        "total_posts": { "value_count": { "field": "MESSAGE_ID" }},
        "total_comments": { "sum": { "field": "REPLIES_COUNT" }},
        "total_reactions": { "sum": { "field": "REACTIONS_COUNT" }},
        "total_views": { "sum": { "field": "VIEWS_COUNT" }}
      }
    },
    "per_channel": {
      "terms": {
        "field": "PEER_ID",
        "size": {{ peer_ids | length }}
      },
      "aggs": {
        "total_posts": { "value_count": { "field": "MESSAGE_ID" }},
        "total_comments": { "sum": { "field": "REPLIES_COUNT" }},
        "total_reactions": { "sum": { "field": "REACTIONS_COUNT" }},
        "total_views": { "sum": { "field": "VIEWS_COUNT" }}
      }
    }
  }
}

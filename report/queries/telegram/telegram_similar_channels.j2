{
    "track_total_hits": true,
    "size": "{{size}}",
    "query": {
      "bool": {
        "must": [
          {"match_phrase": {"MESSAGE": "{{search_text}}"}},
          {
            "range": {
              "DATE": {
                "gte": "{{start_date}}",
                "lte": "{{end_date}}"
              }
            }
          }
        ]
      }
    }
}

{
  "track_total_hits": true,
  "size": "{{ size }}",
  "query": {
    "bool": {
      "must": [
        {
          "more_like_this": {
            "fields": ["CLEANED_MESSAGE"],
            "like": "{{ search_text }}",
            "min_term_freq": 1,
            "max_query_terms": 25,
            "minimum_should_match": "70%" 
          }
        },
        {
          "range": {
            "DATE": {
              "gte": "{{start_date}}",
              "lte": "{{end_date}}"
            }
          }
        }
      ]
    }
  },
  "sort": [
    {"DATE": { "order": "asc"}}
  ]
}

{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [ 
        { 
          "range": { 
            "DATE": { 
              "gte": "{{start_date}}", 
              "lte": "{{end_date}}" 
            } 
          } 
        } 
      ],
      "should": [
        {% set groups = [must|length, should|length, must_not|length] | max %}
        {% for i in range(groups) %}
        {
          "bool": {
            "must": [
              {% for term in must[i] %}
              { "multi_match": { "query": "{{ term }}", "type": "phrase", "fields": ["TITLE", "SUMMARY"] } }{% if not loop.last %},{% endif %}
              {% endfor %}
            ],
            "should": [
              {% for term in should[i] %}
              { "multi_match": { "query": "{{ term }}", "type": "phrase", "fields": ["TITLE", "SUMMARY"] } }{% if not loop.last %},{% endif %}
              {% endfor %}
            ],
            {% if should[i]|length > 0 %}
            "minimum_should_match": 1,
            {% endif %}
            "must_not": [
              {% for term in must_not[i] %}
              { "multi_match": { "query": "{{ term }}", "type": "phrase", "fields": ["TITLE", "SUMMARY"] } }{% if not loop.last %},{% endif %}
              {% endfor %}
            ]
          }
        }{% if not loop.last %},{% endif %}
        {% endfor %}
      ],
      "minimum_should_match": 1
    }
  },
  "aggs": {
    "history": { 
      "date_histogram": { "field": "DATE", "calendar_interval": "day" }
    },
    "sentiment": { 
      "terms": { "field": "SENTIMENT.keyword", "size": 3 } 
    },
    "publishers": { 
      "terms": { "field": "CHANNEL_NAME.keyword", "size": 20 }
    },
    "hours": {
      "terms": {
        "script": { "source": "doc['DATE'].value.getHour()" },
        "size": 24,
        "order": { "_key": "asc" }
      }
    }
  },
  "sort": [
    { "DATE": { "order": "desc" } }
  ]
}
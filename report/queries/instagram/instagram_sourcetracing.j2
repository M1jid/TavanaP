{
  "track_total_hits": true,
  "size": "{{ size }}",
  "_source": [
    "username",
    "caption",
    "url",
    "like_count",
    "taken_at"
  ],
  "query": {
    "bool": {
      "must": [
        {
          "more_like_this": {
            "fields": ["caption"],
            "like": "{{ search_text }}",
            "min_term_freq": 1,
            "max_query_terms": 25,
            "minimum_should_match": "70%"
          }
        },
        {
          "range": {
            "taken_at": {
              "gte": "{{ start_date }}",
              "lte": "{{ end_date }}"
            }
          }
        }
      ]
    }
  },
  "sort": [
    { "taken_at": { "order": "asc" } }
  ]
}